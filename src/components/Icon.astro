---
/**
 * 内联 SVG 图标集。
 *
 * 取代原站的 icomoon 字体图标：字体图标无法被屏幕阅读器正确朗读、
 * 需要额外下载 4 个字体文件、且字形受 font-family 覆盖影响易失效。
 * 内联 SVG 零请求、可用 currentColor 继承文字色、可直接做描边动画。
 */
interface Props {
  name: string;
  class?: string;
  /** 描边宽度，仅对 stroke 类图标生效 */
  width?: number;
}

const { name, class: className = '', width: sw = 1.8 } = Astro.props;

/** 图标定义：vb = viewBox，body = 内部标记，filled = 是否用填充而非描边 */
const ICONS: Record<string, { vb: string; body: string; filled?: boolean }> = {
  github: {
    vb: '0 0 16 16',
    filled: true,
    body: '<path d="M8 0c4.42 0 8 3.58 8 8a8.01 8.01 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82a7.6 7.6 0 0 0-2-.27c-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.99 7.99 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/>',
  },
  // 微博沿用通用「分享节点」字形：不伪造品牌 logo，语义由 aria-label 承载
  weibo: {
    vb: '0 0 24 24',
    body: '<circle cx="18" cy="5" r="2.6"/><circle cx="6" cy="12" r="2.6"/><circle cx="18" cy="19" r="2.6"/><path d="M8.3 10.8 15.7 6.2M8.3 13.2l7.4 4.6"/>',
  },
  rss: {
    vb: '0 0 24 24',
    body: '<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none"/>',
  },
  mail: {
    vb: '0 0 24 24',
    body: '<rect x="2.5" y="4.5" width="19" height="15" rx="2"/><path d="m3 6 9 7 9-7"/>',
  },
  // 复制链接：两段互扣的链条
  link: {
    vb: '0 0 24 24',
    body: '<path d="M10.4 13.6a4.2 4.2 0 0 0 6 0l2.4-2.4a4.24 4.24 0 0 0-6-6l-1.2 1.2"/><path d="M13.6 10.4a4.2 4.2 0 0 0-6 0l-2.4 2.4a4.24 4.24 0 0 0 6 6l1.2-1.2"/>',
  },
  // 站外分享：向上箭头出框
  share: {
    vb: '0 0 24 24',
    body: '<path d="M12 15.5V4"/><path d="m7.8 7.8 4.2-3.8 4.2 3.8"/><path d="M4.5 13v6.5h15V13"/>',
  },
  search: {
    vb: '0 0 24 24',
    body: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/>',
  },
  clock: {
    vb: '0 0 24 24',
    body: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  },
  calendar: {
    vb: '0 0 24 24',
    body: '<rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
  },
  tag: {
    vb: '0 0 24 24',
    body: '<path d="M3.5 11.2V4.5a1 1 0 0 1 1-1h6.7a1 1 0 0 1 .7.3l8.3 8.3a1 1 0 0 1 0 1.4l-6.7 6.7a1 1 0 0 1-1.4 0L3.8 11.9a1 1 0 0 1-.3-.7Z"/><circle cx="7.8" cy="7.8" r="1.3"/>',
  },
  list: {
    vb: '0 0 24 24',
    body: '<path d="M9 6h11M9 12h11M9 18h11"/><circle cx="4.5" cy="6" r="1.2" fill="currentColor" stroke="none"/><circle cx="4.5" cy="12" r="1.2" fill="currentColor" stroke="none"/><circle cx="4.5" cy="18" r="1.2" fill="currentColor" stroke="none"/>',
  },
  chevronLeft: { vb: '0 0 24 24', body: '<path d="m14.5 5-7 7 7 7"/>' },
  chevronRight: { vb: '0 0 24 24', body: '<path d="m9.5 5 7 7-7 7"/>' },
  arrowUpRight: { vb: '0 0 24 24', body: '<path d="M7 17 17 7M8.5 7H17v8.5"/>' },
  terminal: {
    vb: '0 0 24 24',
    body: '<rect x="2.5" y="4" width="19" height="16" rx="2"/><path d="m7 9.5 3 2.5-3 2.5M13 15h4"/>',
  },
  // 越野轨迹母题图标：折线 + 节点
  trail: {
    vb: '0 0 24 24',
    body: '<path d="M2.5 18.5 7 10l4.5 5L16 6l5.5 12.5"/><circle cx="7" cy="10" r="1.4" fill="currentColor" stroke="none"/><circle cx="16" cy="6" r="1.4" fill="currentColor" stroke="none"/>',
  },
};

const icon = ICONS[name];
const filled = icon?.filled ?? false;
---

{
  icon ? (
    <svg
      class={className}
      viewBox={icon.vb}
      fill={filled ? 'currentColor' : 'none'}
      stroke={filled ? 'none' : 'currentColor'}
      stroke-width={filled ? undefined : sw}
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      set:html={icon.body}
    />
  ) : null
}
